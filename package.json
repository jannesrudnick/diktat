{
  "name": "diktat",
  "version": "0.3.0",
  "description": "Floating realtime dictation for macOS (Soniox STT)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.diktat.app",
    "productName": "Diktat",
    "files": [
      "*.js",
      "*.html",
      "assets/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Diktat transkribiert deine Sprache.",
        "LSUIElement": true
      },
      "identity": "-",
      "hardenedRuntime": false
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "synopsis": "Floating realtime dictation"
    }
  },
  "author": "Jannes Rudnick <mail@jannesrudnick.com>",
  "homepage": "https://github.com/jannesrudnick/diktat",
  "repository": "github:jannesrudnick/diktat"
}
